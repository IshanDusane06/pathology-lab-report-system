
# Server configuration
PORT=3000
NODE_ENV=development

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/patho-connect
# or Atlas connection string:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/patho-connect

# JWT secret
JWT_SECRET=your_jwt_secret_key_here

# HMAC secret used to sign report content hashes at doctor sign-off
SIGNING_SECRET=your_signing_secret_key_here

# CORS origins
CORS_ORIGINS=http://localhost:8080,https://your-production-domain.com

# Where the frontend is served — the PDF renderer loads /report/:id/export
# from here in headless Chromium.
FRONTEND_URL=http://localhost:8080

# How many reports to render to PDF concurrently when merging several into
# one document (email attachments, combined downloads). Each render is a
# real Chromium tab against ~30s timeouts, so raise this only if the host has
# the CPU/memory to spare — too much concurrency trips those timeouts instead
# of just taking longer.
PDF_RENDER_CONCURRENCY=3

# Redis — backs the background job queue (report email/PDF rendering,
# signature re-verification) and the SSE job-completion push. Install
# locally with `brew install redis && brew services start redis`, or
# `docker run -d --name patho-redis -p 6379:6379 redis:7-alpine`.
REDIS_URL=redis://127.0.0.1:6379

# How many report-email/report-pdf jobs the worker processes at once. Each
# job renders N reports to PDF (already concurrent per PDF_RENDER_CONCURRENCY
# above), so this is a second, outer concurrency cap on top of that.
REPORT_WORKER_CONCURRENCY=2

# How long a rendered PDF's bytes stay fetchable from the background job
# before the download link expires and the job must be re-requested.
PDF_RESULT_TTL_SECONDS=600

# Whether the BullMQ worker runs inside this same process (true, the
# default — reuses the already-warm cached Chromium browser) or must be
# started separately via `npm run worker` (false, for a split-process
# deployment).
RUN_WORKER_INLINE=true

# Outgoing email (SMTP). Credentials live here only, never in the database
# and never returned by any API. The sender name/address shown to patients is
# configured separately by an Admin in Lab Settings.
#
# Gmail: SMTP_USER must be the full address, and SMTP_PASS must be a 16-char
# App Password (Google Account > Security > App passwords, requires 2FA) —
# not the account password. The Lab Settings sender address must match
# SMTP_USER or be a verified alias, or Gmail will rewrite/reject the From.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_sender_address@gmail.com
SMTP_PASS=your_app_password_here
